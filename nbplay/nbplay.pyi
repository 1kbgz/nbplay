class AudioFormat:
    def __init__(self, sample_rate: int = 44100, channels: int = 2) -> None: ...
    @property
    def sample_rate(self) -> int: ...
    @property
    def channels(self) -> int: ...

class AudioBuffer:
    def __init__(self, frames: int, sample_rate: int = 44100, channels: int = 1) -> None: ...
    @property
    def frames(self) -> int: ...
    @property
    def format(self) -> AudioFormat: ...
    def __len__(self) -> int: ...
    def sample_at(self, frame: int, channel: int) -> float: ...
    def set_sample(self, frame: int, channel: int, value: float) -> None: ...
    def clear(self) -> None: ...
    def to_list(self) -> list[float]: ...

class MidiChannel:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...

class Note:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...
    def to_hz(self) -> float: ...
    @staticmethod
    def from_hz(hz: float) -> Note: ...

class Velocity:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...

class MidiMessage:
    @staticmethod
    def note_on(channel: int, note: int, velocity: int) -> MidiMessage: ...
    @staticmethod
    def note_off(channel: int, note: int, velocity: int) -> MidiMessage: ...
    @staticmethod
    def control_change(channel: int, control: int, value: int) -> MidiMessage: ...
    @staticmethod
    def program_change(channel: int, program: int) -> MidiMessage: ...
    @staticmethod
    def pitch_bend(channel: int, value: int) -> MidiMessage: ...
    @staticmethod
    def clock() -> MidiMessage: ...
    @staticmethod
    def start() -> MidiMessage: ...
    @staticmethod
    def stop() -> MidiMessage: ...

class MidiEvent:
    def __init__(self, message: MidiMessage, timestamp_us: int) -> None: ...
    @property
    def message(self) -> MidiMessage: ...
    @property
    def timestamp_us(self) -> int: ...

class SineOscillator:
    def __init__(self, frequency: float = 440.0, amplitude: float = 1.0, sample_rate: int = 44100) -> None: ...
    @property
    def frequency(self) -> float: ...
    @property
    def amplitude(self) -> float: ...
    @property
    def sample_rate(self) -> int: ...
    def render_to_buffer(self, frames: int) -> list[float]: ...

class SquareOscillator:
    def __init__(self, frequency: float = 440.0, amplitude: float = 1.0, sample_rate: int = 44100) -> None: ...
    @property
    def frequency(self) -> float: ...
    @property
    def amplitude(self) -> float: ...
    @property
    def sample_rate(self) -> int: ...
    def render_to_buffer(self, frames: int) -> list[float]: ...

class SawOscillator:
    def __init__(self, frequency: float = 440.0, amplitude: float = 1.0, sample_rate: int = 44100) -> None: ...
    @property
    def frequency(self) -> float: ...
    @property
    def amplitude(self) -> float: ...
    @property
    def sample_rate(self) -> int: ...
    def render_to_buffer(self, frames: int) -> list[float]: ...

class NoiseSource:
    def __init__(self, amplitude: float = 1.0, seed: int = 42) -> None: ...
    @property
    def amplitude(self) -> float: ...
    def render_to_buffer(self, frames: int) -> list[float]: ...

class MixerChannel:
    name: str
    gain: float
    pan: float
    mute: bool
    solo: bool
    def __init__(self, name: str = "Channel") -> None: ...
    def process_sample(self, sample: float) -> tuple[float, float]: ...

class Mixer:
    master_gain: float
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def channel_count(self) -> int: ...
    def add_channel(self, name: str) -> int: ...
    def remove_channel(self, index: int) -> MixerChannel | None: ...
    def get_channel(self, index: int) -> MixerChannel: ...
    def set_channel_gain(self, index: int, gain: float) -> None: ...
    def set_channel_pan(self, index: int, pan: float) -> None: ...
    def set_channel_mute(self, index: int, mute: bool) -> None: ...
    def set_channel_solo(self, index: int, solo: bool) -> None: ...
    def mix_down(self, channel_buffers: list[list[float]]) -> list[float]: ...
    def channel_names(self) -> list[str]: ...

class Step:
    note: int
    velocity: int
    duration_ticks: int
    active: bool
    def __init__(self, note: int, velocity: int, duration_ticks: int = 1) -> None: ...

class Pattern:
    loop_enabled: bool
    def __init__(self, length: int = 16) -> None: ...
    @property
    def length(self) -> int: ...
    def __len__(self) -> int: ...
    def set_step(self, index: int, step: Step) -> bool: ...
    def toggle_step(self, index: int) -> bool: ...
    def get_step(self, index: int) -> Step: ...
    def clear(self) -> None: ...

class NoteEvent:
    beat_position: float
    duration: float
    note: int
    velocity: int
    def __init__(self, beat_position: float, duration: float, note: int, velocity: int) -> None: ...
    def end_position(self) -> float: ...

class EventSequence:
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def add_event(self, event: NoteEvent) -> None: ...
    def remove_event(self, index: int) -> NoteEvent | None: ...
    def events(self) -> list[NoteEvent]: ...
    def events_in_range(self, start: float, end: float) -> list[NoteEvent]: ...
    def events_starting_in_range(self, start: float, end: float) -> list[NoteEvent]: ...
    def duration(self) -> float: ...
    def clear(self) -> None: ...

class TransportClock:
    bpm: float
    ticks_per_beat: int
    def __init__(self, bpm: float = 120.0) -> None: ...
    @property
    def position(self) -> float: ...
    @property
    def state(self) -> str: ...
    def play(self) -> None: ...
    def pause(self) -> None: ...
    def stop(self) -> None: ...
    def seek(self, beat: float) -> None: ...
    def advance_by_frames(self, frames: int, sample_rate: int) -> tuple[float, float] | None: ...
    def beats_to_seconds(self, beats: float) -> float: ...
    def seconds_to_beats(self, seconds: float) -> float: ...
    def beats_to_ticks(self, beats: float) -> int: ...
    def ticks_to_beats(self, ticks: int) -> float: ...

class StepSequencer:
    step_duration: float
    def __init__(self, pattern: Pattern, channel: int = 0) -> None: ...
    @property
    def current_step(self) -> int: ...
    def set_pattern(self, pattern: Pattern) -> None: ...
    def reset(self) -> None: ...
    def process_beat_range(self, start: float, end: float) -> list[tuple[str, int, int, int]]: ...

class AudioSample:
    root_note: int
    loop_start: int | None
    loop_end: int | None
    def __init__(self, data: list[float], sample_rate: int = 44100, root_note: int = 69) -> None: ...
    @property
    def sample_rate(self) -> int: ...
    def __len__(self) -> int: ...
    def duration_seconds(self) -> float: ...
    def data(self) -> list[float]: ...

class Envelope:
    attack: float
    decay: float
    sustain: float
    release: float
    def __init__(self, attack: float = 0.005, decay: float = 0.1, sustain: float = 0.8, release: float = 0.1) -> None: ...

class SampleMapping:
    def __init__(self, sample: AudioSample, note_low: int, note_high: int, velocity_low: int, velocity_high: int) -> None: ...
    def matches(self, note: int, velocity: int) -> bool: ...

class SampleMap:
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    @staticmethod
    def single_sample(sample: AudioSample) -> SampleMap: ...
    def add_mapping(self, mapping: SampleMapping) -> None: ...
    def find_sample(self, note: int, velocity: int) -> AudioSample | None: ...
    def mapping_count(self) -> int: ...

class Sampler:
    max_voices: int
    def __init__(self, sample: AudioSample, sample_rate: int = 44100, max_voices: int = 8) -> None: ...
    @property
    def sample_rate(self) -> int: ...
    def set_envelope(self, envelope: Envelope) -> None: ...
    def note_on(self, note: int, velocity: int) -> None: ...
    def note_off(self, note: int) -> None: ...
    def active_voice_count(self) -> int: ...
    def all_notes_off(self) -> None: ...
    def panic(self) -> None: ...
    def render(self, frames: int) -> list[float]: ...

class AudioOutput:
    def __init__(self, sample_rate: int = 44100, channels: int = 2, buffer_size: int = 512) -> None: ...
    @staticmethod
    def list_devices() -> list[str]: ...
    def device_name(self) -> str: ...
    def is_playing(self) -> bool: ...
    def stop(self) -> None: ...

class MidiInput:
    def __init__(self, client_name: str = "nbplay") -> None: ...
    def list_ports(self) -> list[str]: ...
